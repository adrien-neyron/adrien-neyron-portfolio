+html.loop-on .pl-more:focus-visible{outline:3px solid #FFFFFF;outline-offset:3px}
+html.loop-on .pl-dock .pl-metrics.plate{background:#050811;border:1px solid rgba(255,255,255,.2);box-shadow:0 8px 28px rgba(0,0,0,.55)}
+@media (max-width:899px){html.loop-on .pl-dock{bottom:calc(env(safe-area-inset-bottom,0px) + 80px)}}
